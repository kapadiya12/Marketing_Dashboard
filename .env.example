# Copy to .env and adjust. Never commit .env.

DJANGO_DEBUG=True
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database. Turso is used when TURSO_DATABASE_URL is set; otherwise PostgreSQL via DATABASE_URL.
# If neither is set, a local SQLite file is used for development only.
# TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
# TURSO_AUTH_TOKEN=
# DATABASE_URL=postgres://dashboard_user:strong-password@localhost:5432/business_dashboard

# Production hardening (set when DJANGO_DEBUG=False)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# Email (password reset, notifications). Console backend prints emails in development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=dashboard@localhost

# Encryption key for stored integration tokens (Fernet key). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=

# Upload limits
MAX_UPLOAD_SIZE_MB=15

# Login throttling
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
CURRENCY_SYMBOL=₹
